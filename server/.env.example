# Jum e-SIM — Module 5 number rental (copy to .env, never commit real values)
# With no keys set, the server runs in DRY-RUN mode with fake inventory.

# Twilio DID provider (Incoming Numbers API + Messaging for verification SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Pin CORS to your app's origin in production — comma-separate multiple
# origins. Dev uses a loopback value; production must be the real domain.
APP_ORIGIN=https://jumesim.com

PORT=8787
