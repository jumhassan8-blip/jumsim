rules_version = '2';
// Jum e-SIM — Firestore security rules (Module 16)
//
// The client can ONLY touch documents inside its own users/{uid} subtree,
// and only while authenticated as that uid. Provider-priveleged fields
// (iccid, qrUrl, status, usage) are never writable from the client — all
// provider writes go through backend functions via the Admin SDK, which
// bypasses these rules by design.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // user profile doc — owner only
    match /users/{uid} {
      allow read, write: if owns(uid);
    }

    // order docs — owner reads; creates/updates must stamp the caller's uid
    match /users/{uid}/orders/{orderId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false; // deletion happens via Admin SDK on account delete
    }

    // Trigger Email extension outbox: any signed-in user may enqueue their
    // own welcome email; the extension (server-side) reads + deletes docs.
    // Clients can never read back the queue (delivery status is not exposed).
    match /users-welcome/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // public, read-only catalog (populated by backend functions only)
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
